# --- Configuration ---
# 1. Database Location (Private IP of Instance 3)
DB_HOST=10.0.0.30
PUBLIC_IP=YOUR_PUBLIC_IP

# 2. Public Access Point (Public IP/Domain of Instance 1)
PUBLIC_DOMAIN=bill-generator.${PUBLIC_IP}.nip.io

# 3. CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://${PUBLIC_DOMAIN},http://localhost:5173

# 4. Secrets (Placeholders only - NEVER commit real credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
